# Data directories (large, not code)
data/

# Pipeline harness output — regenerable artifacts that contain realistic
# names/ADC#s; keep PII out of the repo. Force-add a _snapshot dir if you
# ever want to commit a golden baseline deliberately.
tests/output/

# Data directories at root (legacy, to be migrated to data/)
pdfs/
extracted/
reviewed/
chunks/
/reports/
field-notes/
*.jsonl
# eval cases are source data, not ignored corpus files
!tests/eval/*.jsonl
*.csv

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
*.egg

# Environment
.env
.env.*

# IDE
.vscode/
.idea/
.worktrees/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Cloud
.cloudbuild/
.gcloudignore

# Policy-chat eval run output
tests/eval/output/

# Guided Operations web client — build output and deps, never committed.
# `npm run build` writes the bundle into the Flask static tree; the Docker
# web-build stage regenerates it, and tests/unit/test_web_app_routes.py asserts
# the unbuilt state, so a stray local build must not become a tracked file.
frontend/web/node_modules/
frontend/web/playwright-report/
frontend/web/test-results/
backend/webapp/static/web/
