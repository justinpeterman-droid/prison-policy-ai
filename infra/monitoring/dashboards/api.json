{
  "displayName": "Access API",
  "mosaicLayout": {"columns": 12,
    "tiles": [
      {"width": 6, "height": 4, "widget": {"title": "API request count", "scorecard": {"timeSeriesQuery": {"timeSeriesFilter": {"filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"${api_service_name}\" AND resource.label.\"location\"=\"${region}\""}}}}},
      {"xPos": 6, "width": 6, "height": 4, "widget": {"title": "API request latency", "scorecard": {"timeSeriesQuery": {"timeSeriesFilter": {"filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"${api_service_name}\" AND resource.label.\"location\"=\"${region}\""}}}}},
      {"yPos": 4, "width": 6, "height": 4, "widget": {"title": "request_event latency buckets", "scorecard": {"timeSeriesQuery": {"timeSeriesFilter": {"filter": "metric.type=\"logging.googleapis.com/user/access_request_event\""}}}}},
      {"xPos": 6, "yPos": 4, "width": 6, "height": 4, "widget": {"title": "API action result and dependency", "scorecard": {"timeSeriesQuery": {"timeSeriesFilter": {"filter": "metric.type=\"logging.googleapis.com/user/access_request_event\""}}}}}
    ]
  }
}
