main:
  steps:
    - timestamp:
        assign:
          - stamp: $${time.format(sys.now(), "%Y%m%dT%H%M%SZ")}
          - object: $${"logical-exports/" + stamp + ".sql.gz"}
    - export:
        call: googleapis.sqladmin.v1.instances.export
        args:
          project: ${project_id}
          instance: ${instance_name}
          body:
            exportContext:
              fileType: SQL
              uri: $${"gs://${bucket_name}/" + object}
              offload: true
              sqlExportOptions: {schemaOnly: false}
        result: operation
    - initialize_poll:
        assign:
          - operation_name: $${operation.name}
          - attempt: 0
          - terminal: false
    - poll:
        call: googleapis.sqladmin.v1.operations.get
        args:
          project: ${project_id}
          operation: $${operation_name}
        result: operation_status
    - decide:
        switch:
          - condition: $${operation_status.status == "DONE"}
            next: done
          - condition: $${attempt >= 20}
            next: timed_out
    - wait:
        call: sys.sleep
        args:
          seconds: 15
        next: increment
    - increment:
        assign:
          - attempt: $${attempt + 1}
        next: poll
    - done:
        return: {operation_id: $${operation_name}, object_uri: $${"gs://${bucket_name}/" + object}, status: $${operation_status.status}}
    - timed_out:
        return: {operation_id: $${operation_name}, object_uri: $${"gs://${bucket_name}/" + object}, status: timeout}
